# =========================================================================
# Forge AI — Agent Engine configuration
# Copy this file to `.env` in this same folder and fill in your real values.
# Nothing in the codebase is hardcoded — every agent reads its behaviour
# from these variables at startup.
# =========================================================================

# ---- LLM provider configuration (REQUIRED) ----
# Forge AI talks to any OpenAI-compatible Chat Completions API: OpenAI,
# OpenRouter, Groq, Together AI, Fireworks, local vLLM / Ollama OpenAI-shim,
# Azure OpenAI (via compatible gateway), etc. Just change these two values.
LLM_PROVIDER=openai
OPENAI_API_KEY=real-key
OPENAI_MODEL=gpt-4o-mini
# Only set this if you use a non-default / compatible endpoint, e.g.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
# Hard ceiling on how long any single LLM call may take (seconds). Prevents an
# agent from silently hanging when the upstream provider is slow/unresponsive.
LLM_TIMEOUT_SECONDS=120
# OpenAI client retry count for transient network errors.
LLM_MAX_RETRIES=2
# Used only to estimate $ cost shown on the dashboard - adjust to your model's pricing.
PRICE_INPUT_PER_1K_USD=0.15
PRICE_OUTPUT_PER_1K_USD=0.60

# ---- Agent engine HTTP server ----
AGENT_ENGINE_HOST=0.0.0.0
AGENT_ENGINE_PORT=8000
CORS_ORIGINS=*

# ---- Pipeline / self-healing behaviour ----
MAX_BUILD_RETRIES=3
MAX_TEST_RETRIES=3
MAX_SECURITY_RETRIES=2
MAX_DEBATE_ROUNDS=3
BUILD_TIMEOUT_SECONDS=180
HEALTH_CHECK_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=1
DEPLOY_PORT_RANGE_START=4100
DEPLOY_PORT_RANGE_END=4200

# ---- Storage ----
WORKSPACE_DIR=./workspace
